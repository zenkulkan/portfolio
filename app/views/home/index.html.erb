<div class="min-h-screen bg-[#11111b] text-[#cdd6f4] font-sans selection:bg-[#f5c2e7]/30" data-controller="reveal">

  <!-- Navigation (Dark Theme) -->
  <nav class="sticky top-0 z-50 bg-[#181825]/90 backdrop-blur-md border-b border-[#313244] shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex space-x-6 text-sm font-bold font-mono text-[#a6adc8]">
        <a href="#summary" class="hover:text-[#cba6f7] transition-colors">~/summary</a>
        <a href="#experience" class="hover:text-[#cba6f7] transition-colors">~/experience</a>
        <a href="#skills" class="hover:text-[#cba6f7] transition-colors">~/skills</a>
      </div>

      <div class="flex items-center space-x-4">
        <a href="/Zen_Kulwatcharothai_Resume.pdf" download class="inline-flex items-center justify-center px-4 py-2 border border-[#f38ba8] text-xs font-mono font-bold rounded text-[#f38ba8] hover:bg-[#f38ba8] hover:text-[#11111b] transition-all">
          Download Resume
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Header -->
  <header id="summary" class="bg-fixed relative overflow-hidden pt-24 pb-32 px-4 sm:px-6 lg:px-8 border-b border-[#313244] bg-gradient-to-b from-[#181825] to-[#11111b]">
    <div class="max-w-6xl mx-auto relative z-10">
      <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-4 text-[#cdd6f4]">
        <%= Resume.name %>
      </h1>
      <p class="text-xl md:text-2xl text-[#a6adc8] font-mono mb-8 max-w-3xl">
        <span class="text-[#f9e2af]">#</span> <%= Resume.title %>
      </p>

      <div class="flex flex-wrap gap-6 text-sm font-mono text-[#a6adc8]">
        <span class="flex items-center"><span class="text-[#f38ba8] mr-2">@email</span> = "<a href="mailto:<%= Resume.email %>" class="text-orange-200 hover:underline"><%= Resume.email %></a>"</span>
        <span class="flex items-center"><span class="text-[#f38ba8] mr-2">@github</span> = "<a href="https://<%= Resume.github %>" class="text-orange-200 hover:underline" target="_blank"><%= Resume.github %></a>"</span>
        <span class="flex items-center"><span class="text-[#f38ba8] mr-2">@linkedin</span> = "<a href="https://<%= Resume.linkedin %>" class="text-orange-200 hover:underline" target="_blank"><%= Resume.linkedin %></a>"</span>

      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">

    <!-- Summary Wrapper -->
    <div data-controller="window" data-reveal-target="item" class="mb-16 relative z-20 -mt-20">
      <!-- Closed Stub -->
      <div data-window-target="stub" data-action="click->window#restore" class="hidden bg-[#181825] rounded-xl border border-dashed border-[#313244] p-3 flex items-center justify-between cursor-pointer hover:border-[#cba6f7]/50 transition-colors">
        <span class="text-xs font-mono text-[#7f849c]">> summary.md (closed)</span>
        <span class="text-xs font-mono text-[#a6e3a1] hover:underline">~$ restore</span>
      </div>

      <!-- Main Window -->
      <div data-window-target="main" class="bg-[#1e1e2e] rounded-xl shadow-2xl border border-[#313244] overflow-hidden transition-all duration-300">
        <div class="bg-[#181825] px-4 py-2 flex items-center border-b border-[#313244]">
          <div class="flex space-x-2">
            <button data-action="click->window#close" class="w-3.5 h-3.5 rounded-full bg-[#f38ba8] flex items-center justify-center focus:outline-none hover:brightness-110" title="Close">
              <svg class="w-2.5 h-2.5 text-[#4c0000]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <button data-action="click->window#minimize" class="w-3.5 h-3.5 rounded-full bg-[#f9e2af] flex items-center justify-center focus:outline-none hover:brightness-110" title="Minimize">
              <svg class="w-2.5 h-2.5 text-[#5c3a00]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"></path></svg>
            </button>
            <button data-action="click->window#maximize" class="w-3.5 h-3.5 rounded-full bg-[#a6e3a1] flex items-center justify-center focus:outline-none hover:brightness-110" title="Maximize">
              <svg class="w-2 h-2 text-[#003300]" fill="currentColor" viewBox="0 0 24 24"><path d="M15 3h6v6h-2V6.41L9.41 16H12v2H3v-9h2v4.59L14.59 4H12V2h9v1z"/></svg>
            </button>
          </div>
          <div class="ml-4 text-xs font-mono text-[#7f849c]">summary.md</div>
        </div>
        <div data-window-target="body" class="p-6 md:p-8 font-mono text-sm md:text-base text-[#a6adc8] leading-relaxed transition-all">
          <span class="text-[#9399b2] italic">/* <%= Resume.summary %> */</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Left Column: Experience -->
      <div id="experience" class="lg:col-span-2 space-y-8 scroll-mt-24">
        <h2 class="text-2xl font-mono font-bold text-[#cba6f7] mb-6 flex items-center">
          <span class="text-[#89b4fa] mr-2">></span> ./experience
        </h2>

        <% Resume.experience.each do |job| %>
          <!-- Job Wrapper -->
          <div data-controller="window" data-reveal-target="item">
            <!-- Closed Stub -->
            <div data-window-target="stub" data-action="click->window#restore" class="hidden bg-[#181825] rounded-xl border border-dashed border-[#313244] p-3 flex items-center justify-between cursor-pointer hover:border-[#cba6f7]/50 transition-colors">
              <span class="text-xs font-mono text-[#7f849c]">> <%= job['company'].parameterize(separator: '_') %>.rb (closed)</span>
              <span class="text-xs font-mono text-[#a6e3a1] hover:underline">~$ restore</span>
            </div>

            <!-- Main Window -->
            <div data-window-target="main" class="bg-[#1e1e2e] rounded-xl shadow-lg border border-[#313244] overflow-hidden hover:border-[#cba6f7]/50 transition-all duration-300 flex flex-col">
              <div class="bg-[#181825] px-4 py-2 flex items-center justify-between border-b border-[#313244] shrink-0">
                <div class="flex items-center">
                  <div class="flex space-x-2">
                    <button data-action="click->window#close" class="w-3.5 h-3.5 rounded-full bg-[#f38ba8] flex items-center justify-center focus:outline-none hover:brightness-110" title="Close">
                      <svg class="w-2.5 h-2.5 text-[#4c0000]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                    <button data-action="click->window#minimize" class="w-3.5 h-3.5 rounded-full bg-[#f9e2af] flex items-center justify-center focus:outline-none hover:brightness-110" title="Minimize">
                      <svg class="w-2.5 h-2.5 text-[#5c3a00]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"></path></svg>
                    </button>
                    <button data-action="click->window#maximize" class="w-3.5 h-3.5 rounded-full bg-[#a6e3a1] flex items-center justify-center focus:outline-none hover:brightness-110" title="Maximize">
                      <svg class="w-2 h-2 text-[#003300]" fill="currentColor" viewBox="0 0 24 24"><path d="M15 3h6v6h-2V6.41L9.41 16H12v2H3v-9h2v4.59L14.59 4H12V2h9v1z"/></svg>
                    </button>
                  </div>
                  <div class="ml-4 text-xs font-mono text-[#7f849c]"><%= job['company'].parameterize(separator: '_') %>.rb</div>
                </div>
                <div class="text-xs font-mono text-[#9399b2]"><%= job['period'] %></div>
              </div>

              <div data-window-target="body" class="p-6 font-mono text-sm overflow-x-auto transition-all">
                <span class="text-[#f5c2e7]">Role</span><span class="text-[#89b4fa]">.</span><span class="text-[#89b4fa]">create!</span><span class="text-[#cdd6f4]">(</span>

                <div class="pl-6 mt-2 space-y-1">
                  <div><span class="text-[#f38ba8]">company:</span> <span class="text-orange-200">"<%= job['company'] %>"</span><span class="text-[#cdd6f4]">,</span></div>
                  <div><span class="text-[#f38ba8]">title:</span> <span class="text-orange-200">"<%= job['role'] %>"</span><span class="text-[#cdd6f4]">,</span></div>

                  <% if job['highlights']&.any? %>
                  <div><span class="text-[#f38ba8]">highlights:</span> <span class="text-[#cdd6f4]">[</span></div>
                  <ul class="pl-6 border-l border-[#313244] ml-2 space-y-3 my-3">
                      <% job['highlights']&.each do |highlight| %>
                      <li class="flex items-start text-orange-200 whitespace-normal leading-relaxed">
                          <!-- select-none prevents the bullet from being copied -->
                          <span class="text-[#f38ba8] mr-3 mt-0.5 font-bold select-none">▹</span>
                          <span>"<%= highlight %>"<span class="text-[#cdd6f4]">,</span></span>
                      </li>
                      <% end %>
                  </ul>
                  <div><span class="text-[#cdd6f4]">]</span></div>
                  <% end %>
                </div>

                <span class="text-[#cdd6f4]">)</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right Column: Sidebar (Skills) -->
      <div id="skills" class="space-y-8 scroll-mt-24">
        <h2 class="text-2xl font-mono font-bold text-[#cba6f7] mb-6 flex items-center">
          <span class="text-[#89b4fa] mr-2">></span> ./skills
        </h2>

        <% Resume.skills.each do |skill_group| %>
          <!-- Skill Wrapper -->
          <div data-controller="window" data-reveal-target="item">
            <!-- Closed Stub -->
            <div data-window-target="stub" data-action="click->window#restore" class="hidden bg-[#181825] rounded-xl border border-dashed border-[#313244] p-3 flex items-center justify-between cursor-pointer hover:border-orange-200/50 transition-colors">
              <span class="text-xs font-mono text-[#7f849c]">> <%= skill_group['category'].parameterize(separator: '_') %>.json (closed)</span>
              <span class="text-xs font-mono text-orange-200 hover:underline">~$ restore</span>
            </div>

            <!-- Main Window -->
            <div data-window-target="main" class="bg-[#1e1e2e] rounded-xl shadow-lg border border-[#313244] overflow-hidden hover:border-orange-200/50 transition-all duration-300 flex flex-col">
              <div class="bg-[#181825] px-4 py-2 flex items-center border-b border-[#313244] shrink-0">
                <div class="flex space-x-2">
                  <button data-action="click->window#close" class="w-3.5 h-3.5 rounded-full bg-[#f38ba8] flex items-center justify-center focus:outline-none hover:brightness-110" title="Close">
                    <svg class="w-2.5 h-2.5 text-[#4c0000]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                  </button>
                  <button data-action="click->window#minimize" class="w-3.5 h-3.5 rounded-full bg-[#f9e2af] flex items-center justify-center focus:outline-none hover:brightness-110" title="Minimize">
                    <svg class="w-2.5 h-2.5 text-[#5c3a00]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"></path></svg>
                  </button>
                  <button data-action="click->window#maximize" class="w-3.5 h-3.5 rounded-full bg-[#a6e3a1] flex items-center justify-center focus:outline-none hover:brightness-110" title="Maximize">
                    <svg class="w-2 h-2 text-[#003300]" fill="currentColor" viewBox="0 0 24 24"><path d="M15 3h6v6h-2V6.41L9.41 16H12v2H3v-9h2v4.59L14.59 4H12V2h9v1z"/></svg>
                  </button>
                </div>
                <div class="ml-4 text-xs font-mono text-[#7f849c]"><%= skill_group['category'].parameterize(separator: '_') %>.json</div>
              </div>

              <div data-window-target="body" class="p-6 font-mono text-sm leading-relaxed transition-all">
                <span class="text-[#cdd6f4]">{</span>
                <div class="pl-4 py-1">
                  <span class="text-[#f38ba8]">"stack"</span><span class="text-[#cdd6f4]">:</span> <span class="text-[#cdd6f4]">[</span>
                  <div class="pl-4 text-orange-200">
                    <% skill_group['list'].split(',').each_with_index do |skill, index| %>
                      "<%= skill.strip %>"<%= index == skill_group['list'].split(',').length - 1 ? '' : ',' %><br>
                    <% end %>
                  </div>
                  <span class="text-[#cdd6f4]">]</span>
                </div>
                <span class="text-[#cdd6f4]">}</span>
              </div>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>